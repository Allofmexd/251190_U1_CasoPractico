@startuml
left to right direction
title Diagrama de casos de uso - Cartelera de cine
skinparam backgroundColor white
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F7F7F7
  BorderColor #222222
  ArrowColor #222222
}

actor Espectador

rectangle "Sistema de cartelera" {
  usecase "Consultar listado\ncompleto" as UC1
  usecase "Consultar detalles\nde una pelicula" as UC2
  usecase "Seleccionar pelicula" as UC3
  usecase "Validar numero\nde pelicula" as UC4
}

Espectador --> UC1
Espectador --> UC2
UC2 .> UC1 : <<include>>
UC2 .> UC3 : <<include>>
UC3 .> UC4 : <<include>>
@enduml

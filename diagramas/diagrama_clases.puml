@startuml
title Diagrama de clases - Cartelera de cine
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam class {
  BackgroundColor #F7F7F7
  BorderColor #222222
  ArrowColor #222222
}

class Director {
  - nombre : String
  - paisOrigen : String
  + Director(nombre : String, paisOrigen : String)
  + getNombre() : String
  + getPaisOrigen() : String
}

class Pelicula {
  - titulo : String
  - genero : String
  - duracionMinutos : int
  - director : Director
  + Pelicula(titulo : String, genero : String, duracionMinutos : int, director : Director)
  + obtenerResumen() : String
  + obtenerDetalles() : String
}

class Cartelera {
  {static} + CAPACIDAD : int = 5
  - peliculas : arreglo de Pelicula
  - cantidad : int
  + agregarPelicula(pelicula : Pelicula) : boolean
  + mostrarListado() : void
  + consultarDetalle(numero : int) : Pelicula
  + getCantidad() : int
}

class AplicacionCine {
  {static} + main(args : arreglo de String) : void
  {static} - crearCartelera() : Cartelera
}

Pelicula "0..5" *-- "1" Director : director
Cartelera "1" *-- "5" Pelicula : peliculas
AplicacionCine ..> Cartelera : crea y consulta
@enduml
